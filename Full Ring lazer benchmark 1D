def _naive_zc(I, Q, dm, dt, window):
    """Batch formulas of the earlier version, used only to check the streaming version computes the same thing."""
    s = Q / (np.hypot(I, Q) + 1e-9); sg = np.where(s >= 0, 1.0, -1.0); cross = np.zeros_like(s); cross[1:] = (sg[1:] != sg[:-1])
    cs = np.cumsum(cross, 0); cnt = cs.copy(); cnt[window:] = cs[window:] - cs[:-window]
    n = np.minimum(np.arange(1, len(s) + 1), window)[:, None]; w_hat = 2 * np.pi * (cnt / 2.0) / (n * dt)
    cs2 = np.cumsum(np.abs(dm), 0); mm = cs2.copy(); mm[window:] = cs2[window:] - cs2[:-window]; mm = mm / n
    om = w_hat - mm; om[:window] = 0.0; a = 1.0 / window
    return lfilter([a], [1, -(1 - a)], om, axis=0)

def selftest():
    global MODEL
    ok = True
    def chk(name, cond, info=''):
        nonlocal ok; ok &= bool(cond); print(f"  [{'PASS' if cond else 'FAIL'}] {name} {info}")
    print("1) streaming Zero-crossing equals the batch formula")
    s = simulate(cfg_for('mild', 'static'), 3, T_=20.0, R=2)
    est, _ = run_est('Zero-crossing', dict(window=50), s); ref = _naive_zc(s['I'], s['Q'], s['dm'], DT, 50)
    chk('max |streaming - batch|', np.abs(est - ref).max() < 1e-9, f"= {np.abs(est - ref).max():.2e}")
    print("2) memory accounting")
    a = state_bytes_for('EKF', SAVED['mild']['EKF'], np.float64); b = state_bytes_for('EKF', SAVED['mild']['EKF'], np.float32)
    chk('float32 state is half of float64 state', b * 2 == a, f"({a} B vs {b} B)")
    w1 = state_bytes_for('Zero-crossing', dict(window=100)); w2 = state_bytes_for('Zero-crossing', dict(window=200))
    chk('window-based memory grows with window', w2 > w1, f"({w1} B -> {w2} B)")
    print("3) float32 run stays finite for EKF, UKF, RLS")
    for e in ('EKF', 'UKF', 'RLS'):
        est, _ = run_est(e, SAVED['mild'][e], s, np.float32); chk(e, np.isfinite(est).all())
    if not SMOKE:
        print("4) reproduces the earlier v16 numbers (simple gyro model, mild static, seeds 11-13, +-2%)")
        old = MODEL; MODEL = 'base'; exp = {'KF': 0.6109, 'EKF': 0.2437, 'SGD (author)': 0.2787}; got = {e: [] for e in exp}
        for sd in (11, 12, 13):
            sm = simulate(cfg_for('mild', 'static'), sd)
            for e in exp: got[e].append(metrics(run_est(e, SAVED['mild'][e], sm)[0], sm)['norm'])
        MODEL = old
        for e in exp: chk(e, abs(np.mean(got[e]) / exp[e] - 1) < 0.02, f"got {np.mean(got[e]):.4f}, expected {exp[e]:.4f}")
    print("SELFTEST:", "ALL PASSED" if ok else "SOME FAILED"); return ok

