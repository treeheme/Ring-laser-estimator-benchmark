def findings(evs, tuneds, sw, costs):
    F = []; n = 0
    def add(s):
        nonlocal n; n += 1; F.append(f"{n}. {s}")
    for lk, ev in evs.items():
        parts = []
        for r in REGS:
            w, tied = winner(ev, r); parts.append(f"{r}: {w} ({stat(ev, r, w)['mean']:.3f}; tied/within 5%: {', '.join(tied) if tied else 'none'})")
        add(f"**Winners, {LABEL[lk]}** — " + "; ".join(parts) + ".")
    for lk, ev in evs.items():
        allc = [e for e in ORDER if all(stat(ev, r, e)['collapsed'] for r in REGS)]
        somec = [e for e in ORDER if any(stat(ev, r, e)['collapsed'] for r in REGS) and e not in allc]
        nt = [e for e in ORDER if all(stat(ev, r, e)['nontrack'] and not stat(ev, r, e)['collapsed'] for r in REGS)]
        tr = [e for e in ORDER if all(stat(ev, r, e)['corr'] > 0.9 for r in REGS)]
        add(f"**Collapse / tracking, {LABEL[lk]}** — collapsed in all regimes: {', '.join(allc) or 'none'}; collapsed in some: {', '.join(somec) or 'none'}; non-tracking (corr<0.3) in all regimes: {', '.join(nt) or 'none'}; tracking (corr>0.9 in every regime): {', '.join(tr) or 'none'}.")
    for lk, ev in evs.items():
        rows = []
        for r in REGS:
            e = stat(ev, r, 'EKF')['mean']; others = [x for x in ORDER if x not in ('EKF', 'UKF') and not stat(ev, r, x)['collapsed']]
            b = min(others, key=lambda x: stat(ev, r, x)['mean']); bm = stat(ev, r, b)['mean']
            rows.append(f"{r}: EKF {e:.3f} vs best non-EKF/UKF {b} {bm:.3f} ({(bm/e-1)*100:+.0f}%)")
        add(f"**EKF margin, {LABEL[lk]}** — " + "; ".join(rows) + ".")
    if 'mild' in evs and costs:
        ev = evs['mild']; fr = []
        for r in REGS:
            pts = [(costs[e]['ratio'], stat(ev, r, e)['mean'], e) for e in ORDER if not stat(ev, r, e)['collapsed']]
            fr.append(f"{r}: " + " → ".join(frontier(pts)))
        add("**Pareto frontier (cost ascending → accuracy improving), mild** — " + "; ".join(fr) + f". EKF costs {costs['EKF']['ratio']:.1f}× KF, UKF {costs['UKF']['ratio']:.1f}×, SGD {costs['SGD (author)']['ratio']:.1f}×, RLS {costs['RLS']['ratio']:.1f}×.")
    if sw:
        g = sw['glitch']; i0 = g['levels'].index(0.0); i2 = len(g['levels']) - 1
        rat = {e: g['res'][e][i2] / max(g['res'][e][i0], 1e-9) for e in ORDER}
        trk = [e for e in ORDER if g['corr'][e][i0] > 0.5]; notrk = [e for e in ORDER if e not in trk]
        rob = [e for e in trk if rat[e] < 1.5]; bad = [e for e in trk if rat[e] > 3]
        add(f"**Glitches (mild static, {g['levels'][i2]*100:g}% corrupted I/Q)** — error ratio vs clean: robust (<1.5×): {', '.join(f'{e} {rat[e]:.1f}×' for e in rob) or 'none'}; degrade >3×: {', '.join(f'{e} {rat[e]:.1f}×' for e in bad) or 'none'}. Excluded (corr<0.5 even when clean, so a ratio is meaningless): {', '.join(notrk) or 'none'}.")
        d = sw['dither']; lv = d['levels']; i50 = lv.index(50) if 50 in lv else 0; i200 = lv.index(200) if 200 in lv else 2; i1000 = len(lv) - 1
        weak = {e: d['res'][e][i50] / max(d['res'][e][i200], 1e-9) for e in ORDER}
        trk2 = [e for e in ORDER if d['corr'][e][i200] > 0.5]
        wk = [e for e in trk2 if weak[e] > 2]; ok = [e for e in trk2 if weak[e] <= 1.25]
        add(f"**Dither dependence (A/ΩL = {lv[i50]} vs {lv[i200]}, mild static)** — need a strong dither (error >2× worse at {lv[i50]}): {', '.join(f'{e} {weak[e]:.1f}×' for e in wk) or 'none'}; insensitive (≤1.25×): {', '.join(ok) or 'none'}. Error at A/ΩL={lv[i1000]}: " + ", ".join(f"{e} {d['res'][e][i1000]:.3f}" for e in ('EKF', 'SGD (author)', 'KF', 'LP readout')) + ".")
    for lk, ev in evs.items():
        wf = [100 * np.mean(ev[r]['Huber KF']['w_frac']) for r in REGS]
        add(f"**Huber, {LABEL[lk]}** — robust weighting engaged on {', '.join(f'{r} {w:.2f}%' for r, w in zip(REGS, wf))} of updates (threshold {tuneds[lk]['Huber KF']['params']['huber']:g}); " + ("in at least one regime this is <1%, so Huber ≡ KF there and was not meaningfully tested on clean data." if min(wf) < 1 else "robust weighting engaged in all clean regimes."))
    fd = [e for e in ('Zero-crossing', 'FFT-peak')]
    for lk, ev in evs.items():
        add(f"**Frequency-domain estimators, {LABEL[lk]}** — " + "; ".join(f"{e}: " + ", ".join(f"{r} {stat(ev, r, e)['mean']:.3f} (r={stat(ev, r, e)['corr']:+.2f}{', collapsed' if stat(ev, r, e)['collapsed'] else ''})" for r in REGS) for e in fd) + ". (Normalised error 1.0 = no skill.) These see only |ψ̇| from S; see the caveat on the Ω̂ conversion.")
    return F

