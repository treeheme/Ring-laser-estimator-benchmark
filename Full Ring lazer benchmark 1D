# 2. SIMULATOR
# ======================================================================================================
def omega_profile(t, kind):
    """The TRUE rotation history. 'static': slow sinusoid around 0.3 rad/s. 'dynamic': plus ramps, steps and an impulse."""
    base = 0.3 + 0.1 * np.sin(2 * np.pi * t / 100)
    if kind == 'dynamic':
        a = np.zeros_like(t)
        def seg(lo, hi, f):
            m = (t >= lo) & (t < hi); a[m] += f(t[m])
        seg(60, 70, lambda x: 0.15 * (x - 60) / 10); seg(70, 80, lambda x: 0.15 + 0 * x)
        seg(80, 85, lambda x: -0.20 + 0 * x);        seg(85, 95, lambda x: 0.10 * (x - 85) / 10)
        seg(95, 100, lambda x: -0.15 + 0 * x);       seg(100, 102, lambda x: 0.30 + 0 * x)
        seg(102, 115, lambda x: -0.30 * (x - 102) / 13); seg(115, 130, lambda x: 0.20 + 0 * x)
        seg(130, 140, lambda x: -0.10 + 0 * x);      seg(140, 160, lambda x: 0.08 * (x - 140) / 20)
        seg(160, 1e9, lambda x: -0.10 + 0 * x)
        base = base + a
    return base

def ou(rng, tau, std, shape):
    """Ornstein-Uhlenbeck noise: a slowly wandering value with memory time tau (used for bias and lock-in wander)."""
    rho = math.exp(-DT / tau); s = std * math.sqrt(1 - rho ** 2)
    return lfilter([1.0], [1.0, -rho], rng.standard_normal(shape) * s, axis=0)

def simulate(cfg, seed, T_=None, R=R_UNITS):
    """One experiment: R independent gyros that share the same true rotation and lock-in event but have their own noise.
    Physics:  psi_dot = SF*(Omega + dither + bias + drift) - OmegaL*sin(psi + backscatter_phase) + noise
    Outputs only what a real sensor gives: I=cos(psi), Q=sin(psi) (with errors, noise, ADC) and a noisy dither pickoff."""
    T_ = T if T_ is None else T_
    rng = np.random.default_rng(seed); nt = int(round(T_ / DT)); t = np.arange(nt) * DT
    Om = omega_profile(t, cfg['profile'])
    dT = cfg['temp_amp'] * np.sin(2 * np.pi * t / cfg['temp_period'] + 0.3) + cfg['temp_ramp'] * t / T_   # temperature change
    eps = rng.uniform(-cfg['eps_max'], cfg['eps_max'], R)                                                   # backscatter phase
    oml_u = cfg['oml0'] * (1 + cfg['oml_unit_std'] * rng.standard_normal(R))                                # lock-in spread per unit
    sf0 = cfg['sf_std'] * rng.standard_normal(R); dsf = cfg['dither_sf_err'] * rng.standard_normal(R)
    bias = ou(rng, cfg['bias_tau'], cfg['bias_inst'], (nt, R))                                              # bias instability
    rrw = np.cumsum(rng.standard_normal((nt, R)), 0) * cfg['rrw'] * math.sqrt(DT)                           # rate random walk
    ev = np.ones(nt)
    if cfg['oml_event'] == 'step2': ev = np.where(t >= 60, 2.0, 1.0)
    elif cfg['oml_event'] == 'thermal':
        tp = np.clip(t - 30, 0, None); ev = 1 + np.where(t >= 30, 0.4 * np.exp(-tp / 5) + 0.1 * np.exp(-tp / 50), 0)
    oml = oml_u[None, :] * ev[:, None] * (1 + ou(rng, cfg['oml_ou_tau'], cfg['oml_ou_std'], (nt, R))) * (1 + cfg['temp_oml'] * dT[:, None])
    oml = np.maximum(oml, 0.0)
    sf = 1 + sf0[None, :] + cfg['sf_temp'] * dT[:, None]
    drate = Om[:, None] + bias + rrw + cfg['temp_bias'] * dT[:, None]
    d_true = cfg['dither_A'] * np.sin(cfg['dither_w'] * t)
    n_psi = rng.standard_normal((nt, R)) * cfg['arw'] * math.sqrt(DT)                                       # angle random walk
    psi = np.empty((nt, R)); psi[0] = rng.uniform(-np.pi, np.pi, R)
    for k in range(nt - 1):
        psi[k + 1] = psi[k] + DT * (sf[k] * (drate[k] + d_true[k]) - oml[k] * np.sin(psi[k] + eps)) + n_psi[k]
    g2 = 1 + cfg['iq_gain_err'] * rng.standard_normal(R)
    o1 = cfg['iq_offset'] * rng.standard_normal(R); o2 = cfg['iq_offset'] * rng.standard_normal(R)
    phq = cfg['iq_quad_err'] * rng.standard_normal(R)
    I = np.cos(psi) + o1 + cfg['sig_q'] * rng.standard_normal((nt, R))
    Q = g2 * np.sin(psi + phq) + o2 + cfg['sig_q'] * rng.standard_normal((nt, R))
    if cfg['glitch'] > 0:                                                                                    # corrupted readings
        m = rng.random((nt, R)) < cfg['glitch']
        I = np.where(m, rng.uniform(-1.5, 1.5, (nt, R)), I); Q = np.where(m, rng.uniform(-1.5, 1.5, (nt, R)), Q)
    if cfg['adc_bits']:                                                                                      # ADC quantisation
        lsb = 3.0 / 2 ** cfg['adc_bits']
        I = np.round(np.clip(I, -1.5, 1.5) / lsb) * lsb; Q = np.round(np.clip(Q, -1.5, 1.5) / lsb) * lsb
    dm = d_true[:, None] * sf * (1 + dsf[None, :]) + cfg['dither_sig'] * rng.standard_normal((nt, R))      # dither pickoff
    ctx = dict(sig=cfg['sig_q'], oml_nom=cfg['oml0'], f_band=(0.0, 1.2 * (cfg['dither_A'] + cfg['oml0']) / (2 * math.pi)))
    return dict(I=I, Q=Q, dm=dm, Om=Om, t=t, ctx=ctx)

# ======================================================================================================
# 3. ESTIMATORS (streaming).  Every estimator turns the raw I/Q fringes + dither reading into a rotation estimate Omega_hat.
#    Common rules: step(I, Q, d) takes ONE sample for all R gyros at once (arrays of shape (R,)) and returns Omega_hat.
#    Only numpy arrays that live on the object count as "state" (RAM). Constant tables are listed in ROM and counted apart.
# ======================================================================================================
def wrap(x):
    """Fold an angle into (-pi, pi] so a phase error of 2*pi counts as zero."""
    return (x + np.pi) % (2 * np.pi) - np.pi

class Est:
    ROM = (); UPDATE_AT_K0 = False
    def __init__(self, R, ctx, dt, dtype=np.float64, **p):
        self.R, self.ctx, self.dt, self.fp, self.p, self.k = R, ctx, float(dt), dtype, p, 0
        self.dprev = np.zeros(R, dtype=dtype)                 # previous dither reading (every estimator needs it)
        self.setup(**p)
    def z(self, v=0.0): return np.full(self.R, v, dtype=self.fp)
    def setup(self, **p): pass
    def step(self, I, Q, d):
        if self.k == 0:
            self.init(I, Q)
            out = self.update(I, Q, self.dprev, d) if self.UPDATE_AT_K0 else self.z()
        else:
            out = self.update(I, Q, self.dprev, d)
        self.dprev = d.copy(); self.k += 1
        return out
    def state_bytes(self):
        """Real bytes of mutable state held by this estimator (numpy arrays on the object, excluding ROM tables)."""
        return sum(v.nbytes for k, v in self.__dict__.items() if k not in self.ROM and isinstance(v, (np.ndarray, np.generic)))
    def rom_bytes(self):
        return sum(getattr(self, k).nbytes for k in self.ROM)

class Front(Est):
    """Differenced-phase front end shared by LP, Complementary, SGD, RLS and KF-reg.
    Y = (change of phase per second) - dither = noisy reading of  Omega - OmegaL*sin(phase);   S = sin(previous phase)."""
    def init(self, I, Q):
        A = np.hypot(I, Q) + 1e-9; self.pc = I / A; self.ps = Q / A
    def front(self, I, Q, dprev):
        A = np.hypot(I, Q) + 1e-9; c = I / A; s = Q / A
        dphi = np.arctan2(s * self.pc - c * self.ps, c * self.pc + s * self.ps)
        Y = dphi / self.dt - dprev; S = self.ps; self.pc, self.ps = c, s
        return Y, S

class PhaseLoop(Est):
    """Second-order tracking loop on phase. Rotation rate is read off the loop's internal speed state.
    PLL uses a bounded sin() detector; alpha-beta uses the wrapped phase error. Neither models lock-in."""
    SINE = True
    def setup(self, alpha=0.05, ratio=1.0):
        self.alpha = alpha; self.beta = ratio * alpha ** 2 / (2 - alpha)
    def init(self, I, Q): self.ph = np.arctan2(Q, I); self.om = self.z()
    def update(self, I, Q, dprev, d):
        pp = self.ph + self.dt * (self.om + dprev)
        r = (Q * np.cos(pp) - I * np.sin(pp)) / (np.hypot(I, Q) + 1e-9) if self.SINE else wrap(np.arctan2(Q, I) - pp)
        self.ph = pp + self.alpha * r; self.om = self.om + (self.beta / self.dt) * r
        return self.om
class PLL(PhaseLoop): SINE = True
class AlphaBeta(PhaseLoop): SINE = False

class LPReadout(Front):
    """Conventional readout: count fringes, subtract the dither, low-pass. No model of lock-in."""
    def setup(self, alpha=0.003): self.alpha = alpha
    def init(self, I, Q): super().init(I, Q); self.x = self.z()
    def update(self, I, Q, dprev, d):
        Y, S = self.front(I, Q, dprev); self.x = self.x + self.alpha * (Y - self.x); return self.x

class Complementary(Front):
    """Like LP readout but adds back the lock-in term using the NOMINAL lock-in rate (never adapted)."""
    def setup(self, alpha=0.003): self.alpha = alpha
    def init(self, I, Q): super().init(I, Q); self.x = self.z()
    def update(self, I, Q, dprev, d):
        Y, S = self.front(I, Q, dprev); self.x = self.x + self.alpha * (Y + self.ctx['oml_nom'] * S - self.x); return self.x

class SGDAuthor(Front):
    """YOUR estimator 1. Gradient observer: each step it compares the reading with its estimate, nudges the rotation
    estimate, and nudges its lock-in estimate by gradient descent. Cheap; adapts the lock-in rate online."""
    def setup(self, lr=1e-3, k_i=3e-3): self.lr, self.k_i = lr, k_i
    def init(self, I, Q): super().init(I, Q); self.E = self.z(); self.oml = self.z(self.ctx['oml_nom'])
    def update(self, I, Q, dprev, d):
        Y, S = self.front(I, Q, dprev); P = (Y + self.oml * S) - self.E
        self.E = self.E + self.k_i * P; self.oml = np.clip(self.oml - self.lr * P * S, 0.0, 5.0)
        return self.E

class SGDBiexp(Front):
    """YOUR estimator 2. SGD with two extra leaky lock-in terms (fast 5 s, slow 50 s) for slowly fading lock-in.
    NOTE: tau_f / tau_s equal the simulator's true thermal time constants (an advantage / oracle)."""
    def setup(self, lr=1e-3, k_i=3e-3, tau_f=5.0, tau_s=50.0):
        self.lr, self.k_i = lr, k_i; self.a_f = math.exp(-self.dt / tau_f); self.a_s = math.exp(-self.dt / tau_s)
    def init(self, I, Q):
        super().init(I, Q); self.E = self.z(); self.Lb = self.z(self.ctx['oml_nom']); self.Lf = self.z(); self.Ls = self.z()
    def update(self, I, Q, dprev, d):
        Y, S = self.front(I, Q, dprev); oml = self.Lb + self.Lf + self.Ls
        P = (Y + oml * S) - self.E; self.E = self.E + self.k_i * P; g = self.lr * P * S
        self.Lb = np.clip(self.Lb - g, -1.0, 5.0); self.Lf = self.a_f * self.Lf - g; self.Ls = self.a_s * self.Ls - g
        return self.E

class RLS(Front):
    """Recursive least squares fit of  reading = Omega - OmegaL*sin(phase), with forgetting factor lam so it follows changes."""
    def setup(self, lam=0.9999, p0=10.0): self.lam, self.p0 = lam, p0
    def init(self, I, Q):
        super().init(I, Q); self.th0 = self.z(); self.th1 = self.z(self.ctx['oml_nom'])
        self.p11 = self.z(self.p0); self.p12 = self.z(); self.p22 = self.z(self.p0)
    def update(self, I, Q, dprev, d):
        Y, S = self.front(I, Q, dprev); lam = self.lam; h2 = -S
        ph1 = self.p11 + self.p12 * h2; ph2 = self.p12 + self.p22 * h2
        den = lam + ph1 + h2 * ph2; K1 = ph1 / den; K2 = ph2 / den
        e = Y - (self.th0 + h2 * self.th1); self.th0 = self.th0 + K1 * e; self.th1 = self.th1 + K2 * e
        self.p11 = np.minimum((self.p11 - K1 * ph1) / lam, 1e4); self.p12 = (self.p12 - K1 * ph2) / lam
        self.p22 = np.minimum((self.p22 - K2 * ph2) / lam, 1e4)
        return self.th0

class KFReg(Front):
    """Kalman filter that treats [rate, lock-in rate] as slowly drifting parameters of the regression above."""
    def setup(self, q=1e-8, r_mult=1.0):
        self.q = q; self.r = r_mult * 2 * self.ctx['sig'] ** 2 / self.dt ** 2
    def init(self, I, Q):
        super().init(I, Q); L0 = self.ctx['oml_nom']; self.th0 = self.z(); self.th1 = self.z(L0)
        self.p11 = self.z(0.25); self.p12 = self.z(); self.p22 = self.z((0.3 * L0) ** 2)
    def update(self, I, Q, dprev, d):
        Y, S = self.front(I, Q, dprev); self.p11 = self.p11 + self.q * self.dt; self.p22 = self.p22 + self.q * self.dt
        h2 = -S; ph1 = self.p11 + self.p12 * h2; ph2 = self.p12 + self.p22 * h2
        Sv = ph1 + h2 * ph2 + self.r; K1 = ph1 / Sv; K2 = ph2 / Sv
        e = Y - (self.th0 + h2 * self.th1); self.th0 = self.th0 + K1 * e; self.th1 = self.th1 + K2 * e
        self.p11 = self.p11 - K1 * ph1; self.p12 = self.p12 - K1 * ph2; self.p22 = self.p22 - K2 * ph2
        return self.th0

class KFP(Est):
    """Linear Kalman filter on [phase, rate]. Does NOT model lock-in. With huber=thr, large surprises are down-weighted (Huber KF)."""
    def setup(self, q_psi=1e-3, q_om=1e-6, huber=None):
        self.q_psi, self.q_om, self.huber = q_psi, q_om, huber; self.r = self.ctx['sig'] ** 2; self.eng = 0; self.cnt = 0
    def init(self, I, Q):
        self.p = np.arctan2(Q, I); self.v = self.z(); self.p11 = self.z(0.05 ** 2); self.p12 = self.z(); self.p22 = self.z(0.25)
    def update(self, I, Q, dprev, d):
        dt = self.dt; pp = self.p + dt * (self.v + dprev)
        a11 = self.p11 + 2 * dt * self.p12 + dt * dt * self.p22 + self.q_psi * dt; a12 = self.p12 + dt * self.p22; a22 = self.p22 + self.q_om * dt
        y = wrap(np.arctan2(Q, I) - pp); S = a11 + self.r
        if self.huber is not None:
            z = np.abs(y) / np.sqrt(S); w = np.minimum(1.0, self.huber / np.maximum(z, 1e-12))
            self.eng += int((w < 1).sum()); self.cnt += self.R; S = a11 + self.r / w
        K1 = a11 / S; K2 = a12 / S; self.p = pp + K1 * y; self.v = self.v + K2 * y
        self.p11 = (1 - K1) * a11; self.p12 = (1 - K1) * a12; self.p22 = a22 - K2 * a12
        return self.v

class EKF(Est):
    """Extended Kalman filter on [phase, rate, lock-in rate]. Models the lock-in physics directly, reads I/Q as measurements.
    Best accuracy in these tests, at a high cost."""
    ROM = ('I3', 'Qm', 'Rm')
    def setup(self, q_psi=1e-4, q_om=1e-6, q_L=1e-6):
        f = self.fp; self.I3 = np.eye(3, dtype=f); self.Qm = np.diag([q_psi * self.dt, q_om * self.dt, q_L * self.dt]).astype(f)
        self.Rm = (np.eye(2) * self.ctx['sig'] ** 2).astype(f)
    def init(self, I, Q):
        L0 = self.ctx['oml_nom']; f = self.fp
        self.x = np.stack([np.arctan2(Q, I), np.zeros(self.R, f), np.full(self.R, L0, f)], 1)
        self.P = np.tile(np.diag([0.05 ** 2, 0.5 ** 2, (0.3 * L0) ** 2]).astype(f), (self.R, 1, 1))
    def update(self, I, Q, dprev, d):
        R, dt, x = self.R, self.dt, self.x
        s = np.sin(x[:, 0]); c = np.cos(x[:, 0])
        xp = np.stack([x[:, 0] + dt * (x[:, 1] + dprev - x[:, 2] * s), x[:, 1], x[:, 2]], 1)
        F = np.tile(self.I3, (R, 1, 1)); F[:, 0, 0] = 1 - dt * x[:, 2] * c; F[:, 0, 1] = dt; F[:, 0, 2] = -dt * s
        Pp = F @ self.P @ F.transpose(0, 2, 1) + self.Qm
        sp = np.sin(xp[:, 0]); cp = np.cos(xp[:, 0]); H = np.zeros((R, 2, 3), self.fp); H[:, 0, 0] = -sp; H[:, 1, 0] = cp
        nu = np.stack([I - cp, Q - sp], 1); PHt = Pp @ H.transpose(0, 2, 1)
        K = PHt @ np.linalg.inv(H @ PHt + self.Rm); self.x = xp + (K @ nu[:, :, None])[:, :, 0]
        IKH = self.I3 - K @ H; self.P = IKH @ Pp @ IKH.transpose(0, 2, 1) + K @ self.Rm @ K.transpose(0, 2, 1)   # Joseph form
        return self.x[:, 1]

class UKF(EKF):
    """Same model as EKF; the nonlinearity is handled with 7 sigma points instead of a Jacobian. Costs more, gains almost nothing."""
    ROM = ('I3', 'Qm', 'Rm', 'Wm', 'Wc')
    def setup(self, **p):
        super().setup(**p); self.Wm = np.full(7, 1 / 6, self.fp); self.Wm[0] = 0.0; self.Wc = self.Wm.copy(); self.Wc[0] = 2.0
    def update(self, I, Q, dprev, d):
        R, dt, n = self.R, self.dt, 3; self.P = 0.5 * (self.P + self.P.transpose(0, 2, 1))
        try: L = np.linalg.cholesky(n * self.P + 1e-12 * self.I3)
        except np.linalg.LinAlgError: L = np.tile(np.eye(3, dtype=self.fp) * 1e-3, (R, 1, 1))
        sg = np.empty((R, 7, 3), self.fp); sg[:, 0] = self.x
        for i in range(n): sg[:, 1 + i] = self.x + L[:, :, i]; sg[:, 1 + n + i] = self.x - L[:, :, i]
        sf = sg.copy(); sf[:, :, 0] = sg[:, :, 0] + dt * (sg[:, :, 1] + dprev[:, None] - sg[:, :, 2] * np.sin(sg[:, :, 0]))
        xp = (self.Wm[None, :, None] * sf).sum(1); dx = sf - xp[:, None, :]
        Pp = np.einsum('i,nij,nik->njk', self.Wc, dx, dx) + self.Qm
        Z = np.stack([np.cos(sf[:, :, 0]), np.sin(sf[:, :, 0])], -1)
        zp = (self.Wm[None, :, None] * Z).sum(1); dz = Z - zp[:, None, :]
        Szz = np.einsum('i,nij,nik->njk', self.Wc, dz, dz) + self.Rm; Sxz = np.einsum('i,nij,nik->njk', self.Wc, dx, dz)
        K = Sxz @ np.linalg.inv(Szz)
        self.x = xp + (K @ (np.stack([I, Q], 1) - zp)[:, :, None])[:, :, 0]; self.P = Pp - K @ Szz @ K.transpose(0, 2, 1)
        return self.x[:, 1]

class Windowed(Est):
    """Frequency-domain base class. These estimators see only the fringe frequency MAGNITUDE; the conversion
    Omega_hat = 2*pi*f_hat - mean|dither| is exact only if the phase speed never reverses (it does under strong dither).
    They need ring buffers whose size is the window length, so their MEMORY GROWS WITH THE WINDOW."""
    UPDATE_AT_K0 = True
    def setup_win(self, window):
        self.window = int(window); w = self.window
        self.abuf = np.zeros((w, self.R), self.fp); self.asum = self.z(); self.lp = self.z()
    def finish(self, w_hat, d):
        w = self.window; i = self.k % w; a = np.abs(d)
        self.asum = self.asum - self.abuf[i] + a; self.abuf[i] = a            # running mean of |dither| over the window
        n = min(self.k + 1, w)
        om = (w_hat - self.asum / n) if self.k >= w else self.z()
        c = 1.0 / w; self.lp = self.lp * (1 - c) + c * om                      # one-pole low-pass
        return self.lp

class ZeroCross(Windowed):
    """Counts sign changes of sin(phase) in a sliding window to get the fringe frequency. Sees only |speed|, not direction."""
    def setup(self, window=200):
        self.setup_win(window); self.cbuf = np.zeros((self.window, self.R), np.int8); self.cnt = np.zeros(self.R, np.int32)
    def init(self, I, Q):
        s = Q / (np.hypot(I, Q) + 1e-9); self.sgprev = np.where(s >= 0, 1, -1).astype(np.int8)
    def update(self, I, Q, dprev, d):
        s = Q / (np.hypot(I, Q) + 1e-9); sg = np.where(s >= 0, 1, -1).astype(np.int8)
        cross = (sg != self.sgprev).astype(np.int8); self.sgprev = sg
        i = self.k % self.window; self.cnt = self.cnt - self.cbuf[i] + cross; self.cbuf[i] = cross
        n = min(self.k + 1, self.window); f = (self.cnt.astype(self.fp) * 0.5) / (n * self.dt)
        return self.finish((2 * math.pi) * f, d)

class FFTPeak(Windowed):
    """Finds the strongest frequency in a sliding window (parabolic interpolation), re-computed every `hop` samples."""
    ROM = ('win', 'idx')
    def setup(self, window=300, hop=10):
        self.setup_win(window); self.hop = int(hop); w = self.window
        self.sbuf = np.zeros((w, self.R), self.fp); self.win = np.hanning(w)[:, None].astype(self.fp); self.f_hat = self.z()
        freqs = np.fft.rfftfreq(w, self.dt); lo, hi = self.ctx['f_band']
        idx = np.where((freqs >= max(lo, freqs[1])) & (freqs <= hi))[0]
        self.idx = idx if len(idx) >= 3 else np.arange(1, len(freqs) - 1)
    def init(self, I, Q): pass
    def update(self, I, Q, dprev, d):
        w, hop, idx = self.window, self.hop, self.idx
        i = self.k % w; self.sbuf[i] = Q / (np.hypot(I, Q) + 1e-9)
        if self.k >= w - 1 and (self.k - (w - 1)) % hop == 0:
            seg = np.concatenate([self.sbuf[i + 1:], self.sbuf[:i + 1]], 0)            # oldest -> newest
            seg = (seg - seg.mean(0)) * self.win; sub = np.abs(np.fft.rfft(seg, axis=0))[idx]; m = sub.argmax(0)
            mi = np.clip(m, 1, len(idx) - 2); ar = np.arange(self.R)
            a, b, c = sub[mi - 1, ar], sub[mi, ar], sub[mi + 1, ar]
            delta = np.where((m > 0) & (m < len(idx) - 1), 0.5 * (a - c) / (a - 2 * b + c + 1e-12), 0.0)
            self.f_hat = ((idx[m] + delta) * (1.0 / self.dt) / w).astype(self.fp)
        return self.finish((2 * math.pi) * self.f_hat, d)

