def run_est(name, params, sim, dtype=np.float64):
    """Feed a whole simulated experiment through one estimator, sample by sample. Returns (Omega_hat float64, estimator object)."""
    I = sim['I'].astype(dtype); Q = sim['Q'].astype(dtype); dm = sim['dm'].astype(dtype)
    nt, R = I.shape; e = REG[name][0](R, sim['ctx'], DT, dtype, **params); out = np.empty((nt, R), dtype)
    for k in range(nt): out[k] = e.step(I[k], Q[k], dm[k])
    return out.astype(np.float64), e

# ======================================================================================================
# 5. SCORING
# ======================================================================================================
def metrics(est, sim):
    """norm = MAE / MAE of the no-skill predictor that always guesses mean(Omega).  1.0 = no skill, lower = better.
    The first 20 % of the run is skipped (start-up). Also returns correlation and spread (std ratio) to detect 'collapsed' outputs."""
    nt = len(sim['Om']); b = int(0.2 * nt); om = sim['Om'][b:]
    e = np.nan_to_num(est[b:], nan=50., posinf=50., neginf=-50.)
    err = np.minimum(np.abs(e - om[:, None]), 50.)
    mae = float(err.mean()); ns = float(np.abs(om - om.mean()).mean())
    rmse = float(np.sqrt(np.mean(np.minimum((e - om[:, None]) ** 2, 2500.))))
    m = e.mean(1); sd = float(m.std()); so = float(om.std())
    corr = float(np.corrcoef(m, om)[0, 1]) if sd > 1e-12 and so > 1e-12 else 0.0
    if not np.isfinite(corr): corr = 0.0
    return dict(mae=mae, norm=mae / ns, rmse=rmse, corr=corr, std_ratio=sd / so, ns_mae=ns)

