    # --- Sweep B: contamination fraction ---
    def make_contam(pct, seed=11):
        rng = np.random.default_rng(seed)
        nt = int(200.0 / 0.01)
        R_ = 16; DT_ = 0.01
        omega_fn = lambda t: 0.3 + 0.1 * np.sin(2 * np.pi * t / 100)
        psi = rng.uniform(-np.pi, np.pi, R_)
        S_ = np.zeros((nt, R_)); Y_ = np.zeros((nt, R_))
        if pct > 0:
            cmask = rng.random((nt, R_)) < pct
            cmag = rng.choice([-5.0, 5.0], size=(nt, R_))
        else:
            cmask = np.zeros((nt, R_), dtype=bool)
            cmag = np.zeros((nt, R_))
        rho = np.exp(-DT_ / 100.0)
        sigma_ou = 0.003 * np.sqrt(1 - rho**2)
        bias = np.zeros((nt, R_)); rrw = np.zeros((nt, R_))
        for k in range(nt):
            t = k * DT_
            probe = np.sin(2 * np.pi * t / 5)
            oml = 1.0 if t < 60 else 2.0
            if k > 0:
                bias[k] = rho * bias[k-1] + sigma_ou * rng.standard_normal(R_)
                rrw[k]  = rrw[k-1] + 0.0003 * np.sqrt(DT_) * rng.standard_normal(R_)
            dT = 1.0 * np.sin(2 * np.pi * t / 80.0)
            oml_eff = oml * (1 + 0.1 * dT)
            bias_eff = bias[k] + 0.005 * dT
            s = np.sin(psi)
            raw    = omega_fn(t) + bias_eff + rrw[k] + probe - oml_eff * s
            signal = omega_fn(t) + bias_eff + rrw[k] - oml_eff * s
            y_m = signal * (1 + 0.02 * signal)
            noise = 0.03 * np.sqrt(DT_) * rng.standard_normal(R_)
            noise = noise + cmask[k] * cmag[k] * 0.03 * np.sqrt(DT_)
            dpsi = raw * DT_ + noise
            S_[k] = s; Y_[k] = y_m; psi = psi + dpsi
        return S_, Y_, omega_fn, None, DT_

    contam_values = [0.0, 0.01, 0.02, 0.05, 0.10, 0.20]
    sweep_b = sweep_1d('Contamination sweep', make_contam, contam_values, tuned)

