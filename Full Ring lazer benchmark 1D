# ======================= ESTIMATORS: _common =======================
import numpy as np

def wrap(x):
    return (x + np.pi) % (2 * np.pi) - np.pi

def frontend(I, Q, dm, dt):
    """Differenced-phase front end.  Y_k = dphi_k/dt - d_{k-1} = Omega - OmegaL*sin(psi_{k-1}) + noise."""
    A = np.hypot(I, Q) + 1e-9; c = I / A; s = Q / A
    dphi = np.zeros_like(c)
    dphi[1:] = np.arctan2(s[1:] * c[:-1] - c[1:] * s[:-1], c[1:] * c[:-1] + s[1:] * s[:-1])
    Y = np.zeros_like(c); Y[1:] = dphi[1:] / dt - dm[:-1]
    S = np.zeros_like(c); S[1:] = s[:-1]
    return Y, S

def phase_loop(I, Q, dm, dt, alpha, ratio, sine_detector):
    """Second-order type-II tracking loop on phase. beta = ratio*alpha^2/(2-alpha)."""
    nt, R = I.shape; beta = ratio * alpha ** 2 / (2 - alpha)
    ph = np.arctan2(Q[0], I[0]); om = np.zeros(R); est = np.zeros((nt, R))
    for k in range(1, nt):
        pp = ph + dt * (om + dm[k - 1])
        if sine_detector:
            r = (Q[k] * np.cos(pp) - I[k] * np.sin(pp)) / (np.hypot(I[k], Q[k]) + 1e-9)
        else:
            r = wrap(np.arctan2(Q[k], I[k]) - pp)
        ph = pp + alpha * r; om = om + (beta / dt) * r; est[k] = om
    return est

# ======================= ESTIMATORS: phase_tracking =======================
"""Phase-domain estimators: PLL (sin phase detector on I/Q) and LP readout (differenced phase, dither removed, low-passed)."""
import numpy as np
from scipy.signal import lfilter

def run_pll(I, Q, dm, dt, ctx, alpha=0.05, ratio=1.0):
    return phase_loop(I, Q, dm, dt, alpha, ratio, True)

def run_lp(I, Q, dm, dt, ctx, alpha=0.003):
    Y, _ = frontend(I, Q, dm, dt); nt, R = Y.shape; x = np.zeros(R); est = np.zeros((nt, R))
    for k in range(1, nt): x = x + alpha * (Y[k] - x); est[k] = x      # explicit per-step loop (comparable cost)
    return est

# ======================= ESTIMATORS: fixed_gain =======================
"""Fixed-gain estimators: alpha-beta phase tracker (wrapped-phase detector) and complementary (lock-in-compensated readout)."""
import numpy as np
from scipy.signal import lfilter

def run_ab(I, Q, dm, dt, ctx, alpha=0.05, ratio=1.0):
    return phase_loop(I, Q, dm, dt, alpha, ratio, False)

def run_complementary(I, Q, dm, dt, ctx, alpha=0.003):
    """Omega_hat <- Omega_hat + alpha*(Y + OmegaL_nom*sin(psi) - Omega_hat), with the *nominal* lock-in rate (fixed, not adapted)."""
    Y, S = frontend(I, Q, dm, dt); nt, R = Y.shape; x = np.zeros(R); est = np.zeros((nt, R))
    for k in range(1, nt): x = x + alpha * (Y[k] + ctx['oml_nom'] * S[k] - x); est[k] = x
    return est

# ======================= ESTIMATORS: gradient_family =======================
"""Gradient / recursive-regression estimators on the differenced observable Y = Omega - OmegaL*sin(psi)."""
import numpy as np

def run_sgd(I, Q, dm, dt, ctx, lr=1e-3, k_i=3e-3):
    """Author's gradient observer."""
    Y, S = frontend(I, Q, dm, dt); nt, R = Y.shape
    E = np.zeros(R); oml = np.full(R, ctx['oml_nom']); est = np.zeros((nt, R))
    for k in range(1, nt):
        P = (Y[k] + oml * S[k]) - E
        E = E + k_i * P; oml = np.clip(oml - lr * P * S[k], 0.0, 5.0); est[k] = E
    return est

def run_sgd_biexp(I, Q, dm, dt, ctx, lr=1e-3, k_i=3e-3, tau_f=5.0, tau_s=50.0):
    """Leaky-integrator variant (v13).  NOTE: all three components receive the same gradient, so this is a
    leaky integrator with ~3x effective gain, not an identifiable bi-exponential model; tau values are the
    simulator's true thermal time constants (oracle)."""
    Y, S = frontend(I, Q, dm, dt); nt, R = Y.shape
    a_f = np.exp(-dt / tau_f); a_s = np.exp(-dt / tau_s)
    E = np.zeros(R); Lb = np.full(R, ctx['oml_nom']); Lf = np.zeros(R); Ls = np.zeros(R); est = np.zeros((nt, R))
    for k in range(1, nt):
        oml = Lb + Lf + Ls
        P = (Y[k] + oml * S[k]) - E; E = E + k_i * P; g = lr * P * S[k]
        Lb = np.clip(Lb - g, -1.0, 5.0); Lf = a_f * Lf - g; Ls = a_s * Ls - g; est[k] = E
    return est

def run_rls(I, Q, dm, dt, ctx, lam=0.9999, p0=10.0):
    """Exponentially-weighted RLS on y = Omega - OmegaL*sin(psi)."""
    Y, S = frontend(I, Q, dm, dt); nt, R = Y.shape
    th0 = np.zeros(R); th1 = np.full(R, ctx['oml_nom'])
    p11 = np.full(R, p0); p12 = np.zeros(R); p22 = np.full(R, p0); est = np.zeros((nt, R))
    for k in range(1, nt):
        h2 = -S[k]; ph1 = p11 + p12 * h2; ph2 = p12 + p22 * h2
        den = lam + ph1 + h2 * ph2; K1 = ph1 / den; K2 = ph2 / den
        e = Y[k] - (th0 + h2 * th1); th0 = th0 + K1 * e; th1 = th1 + K2 * e
        p11 = np.minimum((p11 - K1 * ph1) / lam, 1e4); p12 = (p12 - K1 * ph2) / lam
        p22 = np.minimum((p22 - K2 * ph2) / lam, 1e4); est[k] = th0
    return est

# ======================= ESTIMATORS: kalman_family =======================
"""Kalman-family estimators.  All take (I, Q, dm, dt, ctx, **params); ctx = dict(sig, oml_nom, f_band)."""
import numpy as np

def run_kfp(I, Q, dm, dt, ctx, q_psi=1e-3, q_om=1e-6, huber=None, return_extras=False):
    """Linear KF on [psi, Omega]; dither is a known input; lock-in term unmodelled.  huber=thr -> one-step
    Huber reweighting of R (r_eff = r / min(1, thr/|z|)).  extras: NIS series and fraction of updates with w<1."""
    nt, R = I.shape; r = ctx['sig'] ** 2
    p = np.arctan2(Q[0], I[0]); v = np.zeros(R)
    p11 = np.full(R, 0.05 ** 2); p12 = np.zeros(R); p22 = np.full(R, 0.5 ** 2)
    est = np.zeros((nt, R)); nis = []; eng = 0; cnt = 0
    for k in range(1, nt):
        pp = p + dt * (v + dm[k - 1])
        a11 = p11 + 2 * dt * p12 + dt * dt * p22 + q_psi * dt; a12 = p12 + dt * p22; a22 = p22 + q_om * dt
        y = wrap(np.arctan2(Q[k], I[k]) - pp); S = a11 + r
        if return_extras: nis.append(y * y / S)
        if huber is not None:
            z = np.abs(y) / np.sqrt(S); w = np.minimum(1.0, huber / np.maximum(z, 1e-12))
            eng += int((w < 1).sum()); cnt += R; S = a11 + r / w
        K1 = a11 / S; K2 = a12 / S; p = pp + K1 * y; v = v + K2 * y
        p11 = (1 - K1) * a11; p12 = (1 - K1) * a12; p22 = a22 - K2 * a12; est[k] = v
    if return_extras:
        return est, dict(nis=np.array(nis), w_frac=(eng / cnt if cnt else 0.0))
    return est

def run_kfr(I, Q, dm, dt, ctx, q=1e-8, r_mult=1.0):
    """Random-walk Kalman filter on regression parameters [Omega, OmegaL]; r = r_mult * 2*sigma^2/dt^2 (differenced-phase noise)."""
    Y, S = frontend(I, Q, dm, dt); nt, R = Y.shape; r = r_mult * 2 * ctx['sig'] ** 2 / dt ** 2
    th0 = np.zeros(R); th1 = np.full(R, ctx['oml_nom'])
    p11 = np.full(R, 0.25); p12 = np.zeros(R); p22 = np.full(R, (0.3 * ctx['oml_nom']) ** 2); est = np.zeros((nt, R))
    for k in range(1, nt):
        p11 = p11 + q * dt; p22 = p22 + q * dt
        h2 = -S[k]; ph1 = p11 + p12 * h2; ph2 = p12 + p22 * h2
        Sv = ph1 + h2 * ph2 + r; K1 = ph1 / Sv; K2 = ph2 / Sv
        e = Y[k] - (th0 + h2 * th1); th0 = th0 + K1 * e; th1 = th1 + K2 * e
        p11 = p11 - K1 * ph1; p12 = p12 - K1 * ph2; p22 = p22 - K2 * ph2; est[k] = th0
    return est

def run_kf_biexp(I, Q, dm, dt, ctx, q=1e-7, r_mult=1.0, tau_f=5.0, tau_s=50.0):
    """4-state regression KF [Omega, L_base, mode_fast, mode_slow] (v13).  NOTE: tau_f/tau_s equal the simulator's
    thermal time constants (oracle); the three lock-in components are individually unidentifiable (only their sum is observed)."""
    Y, S = frontend(I, Q, dm, dt); nt, R = Y.shape; r = r_mult * 2 * ctx['sig'] ** 2 / dt ** 2
    a_f = np.exp(-dt / tau_f); a_s = np.exp(-dt / tau_s); F = np.diag([1.0, 1.0, a_f, a_s]); Qm = np.eye(4) * q * dt
    L0 = ctx['oml_nom']; th = np.zeros((R, 4)); th[:, 1] = L0
    P = np.tile(np.diag([0.25] + [(0.3 * L0) ** 2] * 3), (R, 1, 1)); est = np.zeros((nt, R))
    for k in range(1, nt):
        th = th @ F.T; P = F @ P @ F.T + Qm
        H = np.stack([np.ones(R), -S[k], -S[k], -S[k]], 1)
        PH = (P @ H[:, :, None])[:, :, 0]; Sv = (H * PH).sum(1) + r; K = PH / Sv[:, None]
        th = th + K * (Y[k] - (H * th).sum(1))[:, None]; P = P - K[:, :, None] * PH[:, None, :]; est[k] = th[:, 0]
    return est

def _init(I, Q, R, ctx):
    L0 = ctx['oml_nom']
    x = np.stack([np.arctan2(Q[0], I[0]), np.zeros(R), np.full(R, L0)], 1)
    P = np.tile(np.diag([0.05 ** 2, 0.5 ** 2, (0.3 * L0) ** 2]), (R, 1, 1))
    return x, P

def run_ekf(I, Q, dm, dt, ctx, q_psi=1e-4, q_om=1e-6, q_L=1e-6):
    """EKF on [psi, Omega, OmegaL]; dpsi = dt*(Omega + d - OmegaL sin psi); measurement [cos psi, sin psi]; Joseph-form update."""
    nt, R = I.shape; I3 = np.eye(3); x, P = _init(I, Q, R, ctx)
    Qm = np.diag([q_psi * dt, q_om * dt, q_L * dt]); Rm = np.eye(2) * ctx['sig'] ** 2; est = np.zeros((nt, R))
    for k in range(1, nt):
        s = np.sin(x[:, 0]); c = np.cos(x[:, 0]); d = dm[k - 1]
        xp = np.stack([x[:, 0] + dt * (x[:, 1] + d - x[:, 2] * s), x[:, 1], x[:, 2]], 1)
        F = np.tile(I3, (R, 1, 1)); F[:, 0, 0] = 1 - dt * x[:, 2] * c; F[:, 0, 1] = dt; F[:, 0, 2] = -dt * s
        Pp = F @ P @ F.transpose(0, 2, 1) + Qm
        sp = np.sin(xp[:, 0]); cp = np.cos(xp[:, 0]); H = np.zeros((R, 2, 3)); H[:, 0, 0] = -sp; H[:, 1, 0] = cp
        nu = np.stack([I[k] - cp, Q[k] - sp], 1); PHt = Pp @ H.transpose(0, 2, 1)
        K = PHt @ np.linalg.inv(H @ PHt + Rm); x = xp + (K @ nu[:, :, None])[:, :, 0]
        IKH = I3 - K @ H; P = IKH @ Pp @ IKH.transpose(0, 2, 1) + K @ Rm @ K.transpose(0, 2, 1); est[k] = x[:, 1]
    return est

def run_ukf(I, Q, dm, dt, ctx, q_psi=1e-4, q_om=1e-6, q_L=1e-6):
    """UKF, same model as EKF; scaled UT with alpha=1, beta=2, kappa=0."""
    nt, R = I.shape; n = 3; I3 = np.eye(3)
    Wm = np.full(7, 1 / 6); Wm[0] = 0.0; Wc = Wm.copy(); Wc[0] = 2.0
    x, P = _init(I, Q, R, ctx); Qm = np.diag([q_psi * dt, q_om * dt, q_L * dt]); Rm = np.eye(2) * ctx['sig'] ** 2
    est = np.zeros((nt, R))
    for k in range(1, nt):
        P = 0.5 * (P + P.transpose(0, 2, 1))
        try: L = np.linalg.cholesky(n * P + 1e-12 * I3)
        except np.linalg.LinAlgError: L = np.tile(np.eye(3) * 1e-3, (R, 1, 1))
        sg = np.empty((R, 7, 3)); sg[:, 0] = x
        for i in range(n): sg[:, 1 + i] = x + L[:, :, i]; sg[:, 1 + n + i] = x - L[:, :, i]
        sf = sg.copy(); sf[:, :, 0] = sg[:, :, 0] + dt * (sg[:, :, 1] + dm[k - 1][:, None] - sg[:, :, 2] * np.sin(sg[:, :, 0]))
        xp = (Wm[None, :, None] * sf).sum(1); dx = sf - xp[:, None, :]
        Pp = np.einsum('i,nij,nik->njk', Wc, dx, dx) + Qm
        Z = np.stack([np.cos(sf[:, :, 0]), np.sin(sf[:, :, 0])], -1)
        zp = (Wm[None, :, None] * Z).sum(1); dz = Z - zp[:, None, :]
        Szz = np.einsum('i,nij,nik->njk', Wc, dz, dz) + Rm; Sxz = np.einsum('i,nij,nik->njk', Wc, dx, dz)
        K = Sxz @ np.linalg.inv(Szz)
        x = xp + (K @ (np.stack([I[k], Q[k]], 1) - zp)[:, :, None])[:, :, 0]
        P = Pp - K @ Szz @ K.transpose(0, 2, 1); est[k] = x[:, 1]
    return est

# ======================= ESTIMATORS: frequency_domain =======================
"""Frequency-domain estimators from the RLG literature (zero-crossing: 2021 automated quality assessment;
windowed-FFT peak with parabolic interpolation: Shi 2026).

IMPORTANT (read before interpreting results): from S = sin(psi) alone these estimators recover the fringe-frequency
MAGNITUDE |psi_dot|/(2*pi).  psi_dot = Omega + d(t) - OmegaL sin(psi); with a dither that reverses psi_dot the sign of
Omega is not observable from |psi_dot|.  The only physically defined conversion is  Omega_hat = 2*pi*f_hat - mean_window|d_meas|,
which is exact only when psi_dot never reverses.  Whatever these estimators do under strong dither is therefore a
property of that definition, and is reported as such.  Search band for FFT peak: Shi's 15-25 Hz band is hardware-specific;
here it is derived from the dither spec (0 .. 1.2*(A+OmegaL)/(2*pi) Hz).
Latency of both = window/2 samples."""
import numpy as np
from scipy.signal import lfilter

def _mov_mean(x, window):
    cs = np.cumsum(x, 0); out = cs.copy(); out[window:] = cs[window:] - cs[:-window]
    n = np.minimum(np.arange(1, len(x) + 1), window)[:, None]
    return out / n

def _finish(w_hat, dm, window, dt):
    om = w_hat - _mov_mean(np.abs(dm), window)
    om[:window] = 0.0
    a = 1.0 / window
    return lfilter([a], [1, -(1 - a)], om, axis=0)

def run_zero_cross(I, Q, dm, dt, ctx, window=200):
    s = Q / (np.hypot(I, Q) + 1e-9); sg = np.where(s >= 0, 1.0, -1.0)
    cross = np.zeros_like(s); cross[1:] = (sg[1:] != sg[:-1])
    cs = np.cumsum(cross, 0); cnt = cs.copy(); cnt[window:] = cs[window:] - cs[:-window]
    n = np.minimum(np.arange(1, len(s) + 1), window)[:, None]
    f = (cnt / 2.0) / (n * dt)
    return _finish(2 * np.pi * f, dm, window, dt)

def run_fft_peak(I, Q, dm, dt, ctx, window=300, hop=10):
    s = Q / (np.hypot(I, Q) + 1e-9); nt, R = s.shape; fs = 1.0 / dt
    win = np.hanning(window)[:, None]; freqs = np.fft.rfftfreq(window, dt)
    lo, hi = ctx['f_band']; idx = np.where((freqs >= max(lo, freqs[1])) & (freqs <= hi))[0]
    if len(idx) < 3: idx = np.arange(1, len(freqs) - 1)
    f_hat = np.zeros((nt, R)); ar = np.arange(R)
    for k in range(window - 1, nt, hop):
        seg = s[k - window + 1:k + 1]; seg = (seg - seg.mean(0)) * win
        sub = np.abs(np.fft.rfft(seg, axis=0))[idx]; m = sub.argmax(0)
        mi = np.clip(m, 1, len(idx) - 2)
        a, b, c = sub[mi - 1, ar], sub[mi, ar], sub[mi + 1, ar]
        delta = np.where((m > 0) & (m < len(idx) - 1), 0.5 * (a - c) / (a - 2 * b + c + 1e-12), 0.0)
        f_hat[k:min(k + hop, nt)] = ((idx[m] + delta) * fs / window)[None, :]
    return _finish(2 * np.pi * f_hat, dm, window, dt)

