    if costs and evs:
        lks = list(evs); fig, ax = plt.subplots(len(lks), len(REGS), figsize=(5.2 * len(REGS), 4.4 * len(lks)), squeeze=False)
        for i, lk in enumerate(lks):
            for j, r in enumerate(REGS):
                a = ax[i][j]; pts = []
                for e in ORDER:
                    s = stat(evs[lk], r, e); x = costs[e]['ratio']
                    a.scatter(x, s['mean'], c=('white' if s['collapsed'] else col[FAM[e]]), edgecolors=col[FAM[e]], s=55, zorder=3)
                    a.annotate(e, (x, s['mean']), fontsize=6, xytext=(3, 3), textcoords='offset points')
                    if not s['collapsed']: pts.append((x, s['mean'], e))
                fr = frontier(pts); fx = [costs[n]['ratio'] for n in fr]; fy = [stat(evs[lk], r, n)['mean'] for n in fr]
                a.step(fx, fy, where='post', c='k', lw=1, zorder=2); a.set_xscale('log'); a.set_yscale('log')
                a.axhline(1.0, c='gray', ls=':', lw=1)
                a.set_title(f"{r} — {LABEL[lk]}", fontsize=9); a.set_xlabel('cost ratio vs KF'); a.set_ylabel('normalised error'); a.grid(alpha=.3, which='both')
        fig.tight_layout(); fig.savefig(f"{OUT}/pareto_frontier.png", dpi=130); plt.close(fig)
    if sw:
        fig, ax = plt.subplots(1, 2, figsize=(14, 5))
