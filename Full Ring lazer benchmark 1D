def measure_memory(lockin='mild', log=print):
    P = tuned_params(lockin); s = simulate(cfg_for(lockin, 'static'), 5, T_=8.0, R=1); out = {}
    for e in ORDER:
        rec = {}
        for tag, dt_ in (('f64', np.float64), ('f32', np.float32)):
            I, Q, dm = (s[k].astype(dt_) for k in ('I', 'Q', 'dm'))
            est = REG[e][0](1, s['ctx'], DT, dt_, **P[e])
            for k in range(3): est.step(I[k], Q[k], dm[k])                      # let every state array come into existence
            rec[f'state_{tag}'] = int(est.state_bytes()); rec[f'rom_{tag}'] = int(est.rom_bytes())
        est = REG[e][0](1, s['ctx'], DT, np.float64, **P[e]); I, Q, dm = s['I'], s['Q'], s['dm']
        for k in range(120): est.step(I[k], Q[k], dm[k])                          # warm up (FFT buffers fill)
        tracemalloc.start(); c0, _ = tracemalloc.get_traced_memory(); tracemalloc.reset_peak()
        for k in range(120, 420): est.step(I[k], Q[k], dm[k])
        _, pk = tracemalloc.get_traced_memory(); tracemalloc.stop(); rec['workspace_peak'] = int(max(pk - c0, 0))
        out[e] = rec
    json.dump(out, open(f"{OUT}/memory.json", 'w'), indent=1); log("  memory done")

