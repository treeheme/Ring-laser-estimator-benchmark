            a.axhline(1.0, c='k', ls='--', lw=1, label='no skill'); a.set_yscale('log'); a.set_xscale('log'); a.set_xlabel(xl + (' (0 plotted at 1e-4)' if key == 'glitch' else ''))
            a.set_ylabel('normalised error (1.0 = no skill)'); a.grid(alpha=.3, which='both')
        ax[0].legend(fontsize=6, ncol=2); fig.tight_layout(); fig.savefig(f"{OUT}/sweeps_combined.png", dpi=130); plt.close(fig)

