def ci(a):
    a = np.asarray(a, float); n = len(a)
    if n < 2: return float(a.mean()), float('nan'), float('nan')
    mu = a.mean(); se = a.std(ddof=1) / np.sqrt(n); tc = student_t.ppf(.975, n - 1); return float(mu), float(mu - tc * se), float(mu + tc * se)

def stat(ev, reg, e):
    d = ev[reg][e]; m, lo, hi = ci(d['norm']); sr = float(np.mean(d['std_ratio'])); co = float(np.mean(d['corr']))
    return dict(mean=m, lo=lo, hi=hi, corr=co, sr=sr, collapsed=sr < 0.1, nontrack=co < 0.3)
def flag(s): return ' COLLAPSED' if s['collapsed'] else (' (not tracking)' if s['nontrack'] else '')

def winner(ev, reg):
    v = [e for e in ORDER if not stat(ev, reg, e)['collapsed']]; w = min(v, key=lambda e: stat(ev, reg, e)['mean'])
    wn = np.array(ev[reg][w]['norm']); tied = []
    for e in v:
        if e == w: continue
        m, lo, hi = ci(np.array(ev[reg][e]['norm']) - wn)
        if (lo < 0 < hi) or (m / wn.mean() < 0.05): tied.append(e)
    return w, tied

def pareto(pts):
    best = np.inf; out = []
    for c, er, n in sorted(pts):
        if er < best: out.append(n); best = er
    return out

def fmtb(b): return f"{b/1024:.1f} KB" if b >= 1024 else f"{b} B"

