# 9. COST: speed, lag, energy
# ======================================================================================================
class Energy:
    """Direct measurement through Linux RAPL (Intel/AMD package energy counters) when readable; otherwise an ESTIMATE
    = CPU time x RLG_WATTS (default 15 W per busy core). The mode is recorded and printed so it can never be mistaken."""
    def __init__(self):
        self.paths = [p for p in glob.glob('/sys/class/powercap/intel-rapl:*/energy_uj') if p.split('/')[-2].count(':') == 1]
        try: [int(open(p).read()) for p in self.paths]; self.rapl = bool(self.paths)
        except Exception: self.rapl = False
        self.watts = float(os.environ.get('RLG_WATTS', 15.0))
        self.mode = 'measured (RAPL package counters)' if self.rapl else f'ESTIMATED (CPU time x {self.watts:g} W; no power sensor available)'
    def _read(self): return sum(int(open(p).read()) for p in self.paths) * 1e-6
    def start(self): self.c0 = time.process_time(); self.e0 = self._read() if self.rapl else 0.0
    def stop(self):
        cpu = time.process_time() - self.c0
        return (self._read() - self.e0) if self.rapl else cpu * self.watts

def lag_of(m, om, L=1500, step=10):
    """How many samples the estimate lags behind the truth (peak of the cross-correlation)."""
    a = m - m.mean(); b = om - om.mean(); n = len(a); lags = np.arange(-L, L + 1, step)
    c = [np.dot(a[l:], b[:n - l]) if l >= 0 else np.dot(a[:n + l], b[-l:]) for l in lags]
    return int(lags[int(np.argmax(c))])

def measure_costs(lockin='mild', log=print):
    P = tuned_params(lockin); s = simulate(cfg_for(lockin, 'dynamic'), 99); nt = len(s['Om']); b = int(0.2 * nt)
    meter = Energy(); out = {'_energy_mode': meter.mode}
    for e in ORDER:
        best, ej = np.inf, np.inf
        for _ in range(2):
            meter.start(); t0 = time.perf_counter(); est, _o = run_est(e, P[e], s); dt_ = time.perf_counter() - t0; ej_ = meter.stop()
            if dt_ < best: best, ej = dt_, ej_
        m = metrics(est, s); lag = lag_of(est[b:].mean(1), s['Om'][b:]) if m['corr'] > 0.3 else None
        out[e] = dict(us_per_step=best / nt * 1e6, us_per_unit_step=best / nt / R_UNITS * 1e6, lag_samples=lag,
                      nominal_latency=(P[e]['window'] // 2 if 'window' in P[e] else None),
                      uJ_per_estimate=ej / (nt * R_UNITS) * 1e6, corr=m['corr'])
    kf = out['KF']['us_per_step']
    for e in ORDER: out[e]['ratio'] = out[e]['us_per_step'] / kf
    json.dump(out, open(f"{OUT}/costs.json", 'w'), indent=1); log(f"  costs done; energy mode: {meter.mode}")

