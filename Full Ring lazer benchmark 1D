                elif s['nontrack']: fl.append(f"{lk}/{r}: non-tracking")
        lag = 'n/a (does not track)' if c['lag_samples'] is None else str(c['lag_samples'])
        L.append(f"| {e} | {c['us_per_step']:.0f} | {c['ratio']:.2f}× | {lag} | {c['nominal_latency'] if c['nominal_latency'] is not None else '–'} | {'; '.join(fl) if fl else '–'} |")
    return L + ["\n*Cost ratios reflect this vectorised-numpy implementation (Python-loop overhead dominates small filters); they are not asymptotic FLOP counts. Measured lag = cross-correlation lag of Ω̂ vs Ω on a dynamic mild run (grid step 10 samples).*\n"]

def table_sweep(sw, key, title, xname):
    d = sw[key]; L = [f"### {title}\n", f"| estimator | " + " | ".join(f"{xname}={l:g}" for l in d['levels']) + " |", "|---|" + "---|" * len(d['levels'])]
    for e in ORDER: L.append(f"| {e} | " + " | ".join(f"{v:.3f}" for v in d['res'][e]) + " |")
    L.append("| *no-skill MAE (rad/s)* | " + " | ".join(f"{v:.4f}" for v in d['ns']) + " |"); return L + [""]

