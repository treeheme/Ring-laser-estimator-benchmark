import sys, os, json, time
import numpy as np
from scipy.stats import t as student_t, ttest_rel, spearmanr

OUT = A.OUT; REGS = A.REGS; FAM = {e: REGISTRY[e][1] for e in ORDER}
LABEL = {k: v['label'] for k, v in A.CFG['lockin'].items()}

def log(s): print(s, flush=True)
def ci(a):
    a = np.asarray(a, float); n = len(a)
    if n < 2: return float(a.mean()), float('nan'), float('nan')
    mu = a.mean(); se = a.std(ddof=1) / np.sqrt(n); tc = student_t.ppf(.975, n - 1); return float(mu), float(mu - tc * se), float(mu + tc * se)
def load(name):
    p = f"{OUT}/{name}"; return json.load(open(p)) if os.path.exists(p) else None

# ------------------------------------------------------------------ analysis
def stat(ev, reg, e):
    d = ev[reg][e]; m, lo, hi = ci(d['norm'])
    return dict(mean=m, lo=lo, hi=hi, corr=float(np.mean(d['corr'])), sr=float(np.mean(d['std_ratio'])),
                collapsed=bool(np.mean(d['std_ratio']) < 0.1), nontrack=bool(np.mean(d['corr']) < 0.3))
def flag(s): return ' ⛔collapsed' if s['collapsed'] else (' ⚠non-tracking' if s['nontrack'] else '')
def valid(ev, reg): return [e for e in ORDER if not stat(ev, reg, e)['collapsed']]
def winner(ev, reg):
    v = valid(ev, reg); w = min(v, key=lambda e: stat(ev, reg, e)['mean'])
    wn = np.array(ev[reg][w]['norm']); wm = wn.mean(); tied = []
    for e in v:
        if e == w: continue
        d = np.array(ev[reg][e]['norm']) - wn; m, lo, hi = ci(d)
        if (lo < 0 < hi) or (m / wm < 0.05): tied.append(e)
    return w, tied
def frontier(pts):  # pts: [(cost, err, name)]
    best = np.inf; out = []
    for c, e, n in sorted(pts):
        if e < best: out.append(n); best = e
    return out

# -------------------------------------------------------------------- tables
def table_main(lockin, ev):
    ns = len(ev[REGS[0]]['KF']['norm'])
    L = [f"### Table 1 — {LABEL[lockin]}: normalised error = MAE / MAE(no-skill mean predictor)  (1.0 = no skill) [95% CI over {ns} test seeds] · r = corr(Ω̂, Ω)\n",
         "| estimator | family | " + " | ".join(REGS) + " |", "|---|---|" + "---|" * len(REGS)]
    for e in ORDER:
        cells = []
        for r in REGS:
            s = stat(ev, r, e); cells.append(f"{s['mean']:.3f} [{s['lo']:.3f}, {s['hi']:.3f}] r={s['corr']:.2f}{flag(s)}")
        L.append(f"| {e} | {FAM[e]} | " + " | ".join(cells) + " |")
    L.append("| *no-skill MAE (rad/s)* | – | " + " | ".join(f"{np.mean(ev[r]['_ns']):.4f}" for r in REGS) + " |\n")
    for r in REGS:
        w, tied = winner(ev, r); ws = stat(ev, r, w)
        L.append(f"- **{r}**: best non-collapsed estimator = **{w}** ({ws['mean']:.3f}); within 5% or statistically tied: {', '.join(tied) if tied else 'none'}.")
    L.append("\n*⛔collapsed = std(Ω̂) < 0.1·std(Ω) (near-constant output; excluded from ranking). ⚠non-tracking = corr < 0.3 (ranked, but not following Ω).*\n")
    L += [f"### Table 1b — {LABEL[lockin]}: paired difference vs EKF (normalised error; positive = worse than EKF). Cell: mean diff [95% CI over {ns} seeds]; p7 = paired t-test over seeds (conservative, primary); p112 = over all {ns}x16 unit pairs (units share Ω, ΩL events and seed, so p112 overstates independence)\n",
          "| estimator | " + " | ".join(REGS) + " |", "|---|" + "---|" * len(REGS)]
    for e in ORDER:
        if e == 'EKF': continue
        cells = []
        for r in REGS:
            d = np.array(ev[r][e]['norm']) - np.array(ev[r]['EKF']['norm']); m, lo, hi = ci(d)
            p7 = ttest_rel(ev[r][e]['norm'], ev[r]['EKF']['norm']).pvalue
            if ev[r][e].get('unit_norm'):
                ua = np.array(ev[r][e]['unit_norm']).ravel(); ub = np.array(ev[r]['EKF']['unit_norm']).ravel(); p112 = f"{ttest_rel(ua, ub).pvalue:.2g}"
            else: p112 = 'n/a (embedded reference)'
            cells.append(f"{m:+.3f} [{lo:+.3f}, {hi:+.3f}] p7={p7:.2g}, p112={p112}")
        L.append(f"| {e} | " + " | ".join(cells) + " |")
    return L + [""]

