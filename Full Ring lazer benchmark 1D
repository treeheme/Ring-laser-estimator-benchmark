            out.append(f"| {e} | " + " | ".join(cs) + " |")
        return out + [""]
    L += one("10a. Harsh lock-in (OmegaL/A = 1/40) across runs v14 / v15 / v16", 'harsh', ['v14', 'v15', 'v16'])
    L += one("10b. Mild lock-in (OmegaL/A = 1/200) across runs v15 / v16 (v14 mild never finished)", 'mild', ['v15', 'v16'])
    leg = {'v12': ARCHIVE['v12']['legacy'], 'v13': ARCHIVE['v13']['legacy']}
    cols = [('v12', 'realistic_full'), ('v13', 'static'), ('v13', 'dynamic'), ('v13', 'thermal')]
    ests = []
    for r, reg in cols:
        for e in leg[r][reg]:
            if e not in ests: ests.append(e)
    L += ["### 10c. Older oracle-observable runs (v12, v13) — transcribed, no-skill = mean-Omega predictor\n", "| estimator | " + " | ".join(f"{r} {reg}" for r, reg in cols) + " |", "|---|" + "---|" * len(cols)]
    for e in ests: L.append(f"| {e} | " + " | ".join(('–' if e not in leg[r][reg] else f"{leg[r][reg][e][0]:.3f}") for r, reg in cols) + " |")
    L.append("")
    # key quantities per run
    rows = [('v12', 'legacy'), ('v13', 'legacy'), ('v14', 'harsh'), ('v15', 'mild'), ('v15', 'harsh'), ('v16', 'mild'), ('v16', 'harsh')]
    L += ["### 10d. Key quantities per run: winner (error) · SGD(author)/KF error ratio · EKF margin over best non-EKF/UKF\n", "| run / config | " + " | ".join(REGS) + " |", "|---|" + "---|" * len(REGS)]
    keyq = {}
    for run, lk in rows:
        cells = cells_of(run, lk, evs)
        if not cells: continue
        row = []
        for j, reg in enumerate(REGS):
            rg = 'realistic_full' if (run == 'v12' and j == 0) else reg
            vals = cells.get(rg)
            if not vals: row.append('–'); continue
            n = {e: v[0] for e, v in vals.items()}; w = min(n, key=n.get); parts = [f"{w} {n[w]:.3f}"]
            sk = n['SGD (author)'] / n['KF'] if ('SGD (author)' in n and 'KF' in n) else None
            if sk is not None: parts.append(f"SGD/KF {sk:.2f}")
            mg = None
            if 'EKF' in n:
                oth = [x for x in n if x not in ('EKF', 'UKF')]; b = min(oth, key=n.get); mg = n[b] / n['EKF'] - 1; parts.append(f"EKF margin {mg*100:+.0f}% vs {b}")
            keyq[(run, lk, reg)] = dict(winner=w, best=n[w], sk=sk, margin=mg); row.append(" · ".join(parts))
        L.append(f"| {run} {lk} | " + " | ".join(row) + " |")
    L.append("")
    # rank stability vs v16
    L += ["### 10e. Rank stability vs v16 (Spearman correlation of estimators' mean normalised error over the 3 regimes)\n", "| comparison | common estimators | rho (all) | p | rho excluding Zero-crossing and FFT-peak (trivially at the extremes) | p |", "|---|---|---|---|---|---|"]
    rk = {}
    for run, lk in (('v14', 'harsh'), ('v15', 'harsh'), ('v15', 'mild')):
        a = cells_of(run, lk, evs); b = cells_of('v16', lk, evs)
        if not a or not b: continue
        com = [e for e in ORDER if all(e in a.get(r, {}) for r in REGS) and all(e in b.get(r, {}) for r in REGS)]
        if len(com) < 4: continue
        ma = [np.mean([a[r][e][0] for r in REGS]) for e in com]; mb = [np.mean([b[r][e][0] for r in REGS]) for e in com]
        rho, p = spearmanr(ma, mb); keep = [i for i, e in enumerate(com) if e not in ('Zero-crossing', 'FFT-peak')]
        rho2, p2 = spearmanr([ma[i] for i in keep], [mb[i] for i in keep]); rk[(run, lk)] = (rho, len(com), rho2, len(keep))
        L.append(f"| {run} {lk} vs v16 {lk} | {len(com)} | {rho:+.2f} | {p:.3g} | {rho2:+.2f} (n={len(keep)}) | {p2:.3g} |")
    return L + [""], keyq, rk

def cross_findings(keyq, rk):
    F = []
    ek = [(k, v) for k, v in keyq.items() if v['margin'] is not None]
    won = [k for k, v in ek if v['winner'] in ('EKF', 'UKF')]; lost = [(k, v['winner']) for k, v in ek if v['winner'] not in ('EKF', 'UKF')]
    F.append(f"**EKF/UKF across runs** — EKF or UKF has the lowest error in {len(won)} of {len(ek)} (run, config, regime) cells where EKF was run" + (("; exceptions: " + ", ".join(f"{k[0]} {k[1]} {k[2]} → {w}" for k, w in lost)) if lost else "") + ".")
    byrun = {}
    for (run, lk, reg), v in keyq.items():
        if v['sk'] is not None: byrun.setdefault(f"{run} {lk}", []).append(v['sk'])
    below = [k for k, v in byrun.items() if np.mean(v) < 1]; above = [k for k, v in byrun.items() if np.mean(v) >= 1]
    F.append("**SGD (author) vs KF across runs** — mean SGD/KF error ratio (below 1 = SGD better): " + "; ".join(f"{k} {np.mean(v):.2f}" for k, v in byrun.items()) + f". SGD is better than KF in: {', '.join(below) or 'none'}; worse in: {', '.join(above) or 'none'}. (In the quadrature runs KF has no lock-in model, which is the main reason; see Tables 5 and 10a.)")
    best = {}
    for (run, lk, reg), v in keyq.items(): best.setdefault(f"{run} {lk}", []).append(v['best'])
    F.append("**Discrimination** — best estimator's normalised error per run (mean over regimes; lower = the benchmark separates skill from no skill): " + "; ".join(f"{k} {np.mean(v):.3f}" for k, v in best.items()) + ".")
    if rk: F.append("**Rank stability** — Spearman rho of estimator ranks vs v16: " + "; ".join(f"{r} {lk} {rho:+.2f} all, {rho2:+.2f} excluding the two frequency estimators (n={n2})" for (r, lk), (rho, n, rho2, n2) in rk.items()) + ".")
    return F

def get_results():
    evs = {lk: load(f"eval_{lk}.json") for lk in A.LOCKIN}; evs = {k: v for k, v in evs.items() if v and len(v) == len(REGS)}
    if evs:
        return evs, {lk: load(f"tuned_{lk}.json") for lk in evs}, load('sweeps_mild.json'), load('costs.json'), "LOCAL RUN in " + OUT
    return REFERENCE['eval'], REFERENCE['tuned'], REFERENCE['sweeps'], REFERENCE['costs'], "EMBEDDED REFERENCE RUN (author's finished run: same code, seeds and settings; run main(['all','--resume']) to reproduce it locally)"

def build_doc(evs, tuneds, sw, costs, src):
    hdr = f"Test seeds {A.TEST}; train seeds {A.TRAIN}; {A.R_UNITS} units/seed; T={A.T:g}s, dt={A.DT}; score window = after 20% burn-in. Normalised error = MAE / MAE of the no-skill mean predictor (1.0 = no skill). Sensor model: paper-exact (no SF/temperature/IQ-imbalance terms).\n"
    docs = {}
    for lk in evs:
        docs[lk] = [f"# RLG benchmark v16 — {LABEL[lk]}\n", hdr] + table_main(lk, evs[lk]) + table_abs(lk, evs[lk]) + table_collapse(lk, evs[lk]) + table_huber(lk, evs[lk], tuneds[lk], sw if lk == 'mild' else None) + table_tuning(lk, tuneds[lk])
    C = ["# RLG benchmark v16 — full report: setup, runs, results, cross-run comparison\n", f"**Results source:** {src}\n", hdr] + table_setup(tuneds) + table_runs()
    for i, lk in enumerate(evs):
        C.append(f"## Table {i+1} — {LABEL[lk]}" + (" (PRIMARY HEADLINE)" if lk == 'mild' else " (stress test)") + "\n"); C += table_main(lk, evs[lk]); C += table_abs(lk, evs[lk])
    if costs: C += table_cost(costs, evs)
    for lk in evs: C += table_huber(lk, evs[lk], tuneds[lk], sw if lk == 'mild' else None)
    for lk in evs: C += table_collapse(lk, evs[lk])
    if sw:
        C += table_sweep(sw, 'glitch', 'Table 6 — Glitch sweep (mild static): normalised error vs fraction of corrupted I/Q samples', 'glitch')
        C += table_sweep(sw, 'dither', 'Table 7 — Dither sweep (mild static): normalised error vs A/ΩL (ΩL varied at fixed A)', 'A/ΩL')
    for lk in evs: C += table_tuning(lk, tuneds[lk])
    C += table_anchor(evs)
    cmp_lines, keyq, rk = table_compare(evs); C += cmp_lines
    C += ["## Findings (generated from the numbers above)\n"]
    F = findings(evs, tuneds, sw, costs); n = len(F)
    C += F + [f"{n+i+1}. {t}" for i, t in enumerate(cross_findings(keyq, rk))]
    C += ["", "## Caveats\n"] + [f"- {c}" for c in CAVEATS] + ["- Cross-run comparison (Tables R, 10): runs differ in sensor model, units, seeds and regime definitions; v12/v13 values are transcribed from earlier run outputs and v14/v15 are converted to the common no-skill ratio. Treat it as directional."]
    return C, docs

def report():
    evs, tuneds, sw, costs, src = get_results(); C, docs = build_doc(evs, tuneds, sw, costs, src)
    for lk, L in docs.items(): open(f"{OUT}/results_{lk}.md", 'w').write("\n".join(L))
    open(f"{OUT}/results_combined.md", 'w').write("\n".join(C)); figures(evs, costs, sw)
    show_text("\n".join(C))

def show_all():
    evs, tuneds, sw, costs, src = get_results(); C, _ = build_doc(evs, tuneds, sw, costs, src); show_text("\n".join(C))


# ------------------------------------------------------------------ selftest
IDEAL = dict(oml0=0.0, oml_unit_std=0.0, oml_ou_std=0.0, eps_max=0.0, bias_inst=0.0, rrw=0.0, sf_std=0.0, sf_temp=0.0, temp_amp=0.0,
             temp_ramp=0.0, temp_oml=0.0, temp_bias=0.0, iq_gain_err=0.0, iq_offset=0.0, iq_quad_err=0.0, dither_sig=0.0,
             dither_sf_err=0.0, sig_q=0.002, arw=0.0, profile='const', oml_event='none')
def selftest():
    log("== A. ideal sensor, no lock-in: model-based/regression estimators must recover Omega=0.3 ==")
    s = A.simulate(A.cfg_for('mild', 'static', **IDEAL), 5, T_=100.0, R=4); n = len(s['Om']); late = slice(int(.7 * n), n); ests = {}
    for e in ORDER:
        p = {'Huber KF': dict(huber=1.5), 'EKF': dict(q_psi=4e-4), 'UKF': dict(q_psi=4e-4), 'KF-reg': dict(r_mult=1.0), 'KF-biexp': dict(r_mult=1.0)}.get(e, {})
        t0 = time.time(); est = A.run_est(e, p, s); ests[e] = est
        log(f"  {e:<14} late mean|err| = {np.abs(est[late]-0.3).mean():.4f}  ({time.time()-t0:.1f}s)")
    log("  EKF vs UKF late |diff| = %.5f" % np.abs(ests['EKF'][late] - ests['UKF'][late]).mean())
    log("== B. KF consistency (exact linear-Gaussian): NIS should be ~1 ==")
    c = A.cfg_for('mild', 'static', **IDEAL); c.update(arw=0.03, sig_q=0.02); s = A.simulate(c, 7, T_=200.0, R=8)
    ctx = dict(s['ctx']); est, ex = A.REGISTRY['KF'][0](s['I'], s['Q'], s['dm'], A.DT, ctx, q_psi=0.03 ** 2, q_om=1e-9, return_extras=True)
    log("  mean NIS = %.3f" % ex['nis'][2000:].mean())
    log("== C. frequency-domain estimators on dithered signal (expected: cannot recover signed Omega) ==")
    s = A.simulate(A.cfg_for('mild', 'static', **IDEAL), 5, T_=100.0, R=4)
    for e in ('Zero-crossing', 'FFT-peak'):
        est = A.run_est(e, dict(window=200) if e == 'Zero-crossing' else dict(window=300, hop=10), s)
        log(f"  {e:<14} late mean = {est[late].mean():+.3f}  std = {est[late].mean(1).std():.3f}  (truth 0.300)")

CMDS = ('selftest', 'describe', 'tune', 'eval', 'sweeps', 'costs', 'report', 'show', 'all')
def main(argv=None):
    """CLI / notebook entry.  Script:  python file.py all [--resume].   Notebook:  main(['selftest']) ; main(['all', '--resume'])."""
    argv = list(sys.argv[1:] if argv is None else argv)
    resume = '--resume' in argv; argv = [a for a in argv if a != '--resume']
    if not argv or argv[0] not in CMDS:      # e.g. a notebook kernel's own argv (-f kernel.json): show usage, do not crash
        print(USAGE); print(); show_all(); return
    cmd = argv[0]; lks = [argv[1]] if len(argv) > 1 and argv[1] in A.LOCKIN else A.LOCKIN
    have = lambda f: os.path.exists(f"{OUT}/{f}")
    if cmd == 'selftest': selftest()
    elif cmd == 'describe': describe()
    elif cmd == 'show': show_all()
    elif cmd == 'tune': [A.tune_config(lk, log) for lk in lks]
    elif cmd == 'eval': [A.eval_config(lk, log) for lk in lks]
    elif cmd == 'sweeps': A.eval_sweeps('mild', log)
    elif cmd == 'costs': A.measure_costs('mild', log)
    elif cmd == 'report': report()
    elif cmd == 'all':   # mild first (primary headline), then harsh.  --resume skips stages whose output file already exists
        for lk in ['mild', 'harsh']:
            if resume and have(f"tuned_{lk}.json"): log(f"[resume] tuned_{lk}.json found - skipping tuning")
            else: A.tune_config(lk, log)
            ev = load(f"eval_{lk}.json")
            if resume and ev and len(ev) == len(REGS): log(f"[resume] eval_{lk}.json complete - skipping evaluation")
            else: A.eval_config(lk, log)
            if lk == 'mild':
                if resume and have('sweeps_mild.json') and len(load('sweeps_mild.json')) == 2: log("[resume] sweeps found - skipping")
                else: A.eval_sweeps('mild', log)
                if resume and have('costs.json'): log("[resume] costs.json found - skipping")
                else: A.measure_costs('mild', log)
            report()

if __name__ == "__main__": main()
