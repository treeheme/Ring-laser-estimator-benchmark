# ============================================================
# Extended data generation
# ============================================================
def make_data(scenario, seed=11, T=200.0, R=16, DT=0.01,
              arw=0.03,
              bias_inst=0.0,
              bias_inst_tau=100.0,
              rrw=0.0,
              sf_nonlin=0.0,
              temp_amp=0.0,
              temp_period=80.0,
              temp_oml_gain=0.1,
              temp_bias_gain=0.005):
    """
    Full RLG error-budget data generation.
    dpsi/dt = Omega(t) + bias(t) + rrw(t) + probe - OmegaL_eff(t)*sin(psi)
    y_meas  = signal_rate * (1 + sf_nonlin * signal_rate)
    psi    += raw_rate*DT + arw*sqrt(DT)*N(0,1)
    """
    rng = np.random.default_rng(seed)
    nt = int(T / DT)
    omega_fn = lambda t: 0.3 + 0.1 * np.sin(2 * np.pi * t / 100)
    psi = rng.uniform(-np.pi, np.pi, R)
    S = np.zeros((nt, R)); Y = np.zeros((nt, R))

    # OmegaL baseline dynamics
    if scenario == 'diffusion':
        oml_rw = np.clip(1.0 + np.cumsum(rng.standard_normal(nt) * 0.001), 0.5, 3.0)
        def oml_of(k): return np.full(R, oml_rw[k])
    else:
        def oml_of(k): return np.full(R, 1.0 if k * DT < 60 else 2.0)

    # Contamination
    if scenario == 'extreme_outliers_2pct':
        contam = rng.random((nt, R)) < 0.02
        contam_mag = rng.choice([-5.0, 5.0], size=(nt, R))
    elif scenario == 'extreme_outliers_5pct':
        contam = rng.random((nt, R)) < 0.05
        contam_mag = rng.choice([-10.0, 10.0], size=(nt, R))
    else:
        contam = np.zeros((nt, R), dtype=bool)
        contam_mag = np.zeros((nt, R))

    # OU bias instability
    if bias_inst > 0:
        rho = np.exp(-DT / bias_inst_tau)
        sigma_ou = bias_inst * np.sqrt(1 - rho**2)
    else:
        rho = 1.0
        sigma_ou = 0.0

    bias = np.zeros((nt, R))
    rrw_state = np.zeros((nt, R))
    T_state = np.zeros((nt, R))
    T_0 = 20.0

    for k in range(nt):
        t = k * DT
        probe = np.sin(2 * np.pi * t / 5)
        oml_base = oml_of(k)

        if k > 0:
            if bias_inst > 0:
                bias[k] = rho * bias[k-1] + sigma_ou * rng.standard_normal(R)
            if rrw > 0:
                rrw_state[k] = rrw_state[k-1] + rrw * np.sqrt(DT) * rng.standard_normal(R)

        T_state[k] = T_0 + temp_amp * np.sin(2 * np.pi * t / temp_period)
        dT = T_state[k] - T_0

        oml_eff = oml_base * (1 + temp_oml_gain * dT)
        bias_eff = bias[k] + temp_bias_gain * dT

        s = np.sin(psi)
        raw_rate = omega_fn(t) + bias_eff + rrw_state[k] + probe - oml_eff * s
        signal_rate = omega_fn(t) + bias_eff + rrw_state[k] - oml_eff * s
        y_meas = signal_rate * (1 + sf_nonlin * signal_rate)

        noise = arw * np.sqrt(DT) * rng.standard_normal(R)
        if contam.any():
            noise = noise + contam[k] * contam_mag[k] * arw * np.sqrt(DT)

        dpsi = raw_rate * DT + noise
        S[k] = s
        Y[k] = y_meas
        psi = psi + dpsi

    return S, Y, omega_fn, oml_of, DT


def make_realistic(seed=11):
    """Realistic scenario: all error sources active at typical ratios."""
    return make_data('piecewise', seed=seed,
                     arw=0.03,
                     bias_inst=0.003, bias_inst_tau=100.0,
                     rrw=0.0003, sf_nonlin=0.02,
                     temp_amp=1.0, temp_period=80.0,
                     temp_oml_gain=0.1, temp_bias_gain=0.005)


